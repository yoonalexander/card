{
  "redirects": [
    {
      "source": "/cursora",
      "destination": "https://cursora.alexyoon.com",
      "permanent": true
    },
    {
      "source": "/cursora/:path*",
      "destination": "https://cursora.alexyoon.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/bunny",
      "destination": "https://flowers-eight-inky.vercel.app"
    },
    {
      "source": "/bunny/:path*",
      "destination": "https://flowers-eight-inky.vercel.app/:path*"
    },
    {
      "source": "/flowers/assets/:path*",
      "destination": "https://flowers-eight-inky.vercel.app/flowers/assets/:path*"
    },
    {
      "source": "/xy-fight",
      "destination": "https://xy-ball-fight.vercel.app/index.html"
    },
    {
      "source": "/xy-fight/:path*",
      "destination": "https://xy-ball-fight.vercel.app/:path*"
    },
    {
      "source": "/craveai",
      "destination": "https://crave-ai-eight.vercel.app/craveai"
    },
    {
      "source": "/craveai/:path*",
      "destination": "https://crave-ai-eight.vercel.app/craveai/:path*"
    },
    {
      "source": "/particle-engine",
      "destination": "https://particle-engine-plum.vercel.app"
    },
    {
      "source": "/particle-engine/:path*",
      "destination": "https://particle-engine-plum.vercel.app/:path*"
    }
  ]
}
